# Optional path to a directory containing raw/ and processed/ NASA snapshots.
# Leave unset to use ./data inside the repository.
BOPONX_DATA_ROOT=

# Required only when the browser and API use different origins; comma-separated.
# Example: https://your-app.example
BOPONX_ALLOWED_ORIGINS=

# Frontend build variable (set in frontend/.env.local if needed):
# VITE_BOPONX_API_BASE_URL=https://your-api.example

# No NASA API key is required for the public POWER daily point endpoint.
